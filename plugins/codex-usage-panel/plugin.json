{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-usage-panel",
  "version": "0.2.0",
  "description": "可拖动、置顶的 Codex 额度悬浮窗，也支持自动刷新的侧栏面板。",
  "author": {
    "name": "Mars-cb",
    "url": "https://github.com/Mars-cb"
  },
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex 额度面板",
        "shortDescription": "像桌面小宠物一样随时查看剩余额度",
        "category": "Productivity",
        "defaultPrompt": [
          "打开额度悬浮窗"
        ],
        "developerName": "Mars-cb",
        "websiteURL": "https://github.com/Mars-cb/codex-usage",
        "privacyPolicyURL": "https://github.com/Mars-cb/codex-usage/blob/main/PRIVACY.md",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "screenshots": [
          "./assets/preview.png"
        ]
      }
    }
  },
  "homepage": "https://github.com/Mars-cb/codex-usage",
  "repository": "https://github.com/Mars-cb/codex-usage"
}
